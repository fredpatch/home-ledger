{
  "name": "suivi-financier",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run build -w @suivi/shared -w @suivi/server && node --test \"packages/shared/dist/test/*.test.js\" \"packages/server/dist/test/*.test.js\"",
    "dev:api": "npm run dev -w @suivi/server",
    "dev:client": "npm run dev -w @suivi/client"
  },
  "devDependencies": {
    "typescript": "5.9.3"
  }
}
